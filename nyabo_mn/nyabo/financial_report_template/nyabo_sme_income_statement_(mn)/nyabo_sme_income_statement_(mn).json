  {"reference_code": "REV51", "display_name": "Борлуулалтын орлого (цэвэр) (51, 52)", "indentation_level": 0, "data_source": "Account Data", "balance_type": "Period Movement (Debits - Credits)", "reverse_sign": 1, "bold_text": 1, "include_in_charts": 1,
   "calculation_formula": "[\"account_category\", \"=\", \"Revenue from Operations\"]"},
  {"reference_code": "COGS61", "display_name": "Борлуулсан бүтээгдэхүүний өртөг (61)", "indentation_level": 0, "data_source": "Account Data", "balance_type": "Period Movement (Debits - Credits)", "reverse_sign": 1,
   "calculation_formula": "[\"account_category\", \"in\", [\"Cost of Goods Sold\", \"Other Direct Costs\"]]"},
  {"reference_code": "GROSS", "display_name": "Нийт ашиг (алдагдал)", "indentation_level": 0, "data_source": "Calculated Amount", "bold_text": 1,
   "calculation_formula": "REV51 + COGS61"},
  {"data_source": "Blank Line"},
  {"reference_code": "OPEX71", "display_name": "Борлуулалтын зардал (71)", "indentation_level": 0, "data_source": "Account Data", "balance_type": "Period Movement (Debits - Credits)", "reverse_sign": 1, "hide_when_empty": 1,
   "calculation_formula": "{\"and\": [[\"account_category\", \"=\", \"Operating Expenses\"], [\"account_number\", \"like\", \"71%\"]]}"},
  {"reference_code": "OPEX70", "display_name": "Удирдлагын (ерөнхий) зардал (70)", "indentation_level": 0, "data_source": "Account Data", "balance_type": "Period Movement (Debits - Credits)", "reverse_sign": 1,
   "calculation_formula": "{\"and\": [[\"account_category\", \"=\", \"Operating Expenses\"], [\"account_number\", \"not like\", \"71%\"]]}"},
  {"reference_code": "EBIT", "display_name": "Үндсэн үйл ажиллагааны ашиг (алдагдал)", "indentation_level": 0, "data_source": "Calculated Amount", "bold_text": 1,
   "calculation_formula": "GROSS + OPEX71 + OPEX70"},
  {"data_source": "Blank Line"},
  {"reference_code": "NONOP84", "display_name": "Үндсэн бус үйл ажиллагааны орлого, олз (84)", "indentation_level": 0, "data_source": "Account Data", "balance_type": "Period Movement (Debits - Credits)", "reverse_sign": 1, "hide_when_empty": 1,
   "calculation_formula": "[\"account_category\", \"in\", [\"Other Operating Income\", \"Investment Income\"]]"},
  {"reference_code": "NONOP87", "display_name": "Үндсэн бус үйл ажиллагааны гарз (87)", "indentation_level": 0, "data_source": "Account Data", "balance_type": "Period Movement (Debits - Credits)", "reverse_sign": 1, "hide_when_empty": 1,
   "calculation_formula": "[\"account_category\", \"=\", \"Finance Costs\"]"},
  {"reference_code": "PBT", "display_name": "Татвар төлөхийн өмнөх ашиг (алдагдал)", "indentation_level": 0, "data_source": "Calculated Amount", "bold_text": 1,
   "calculation_formula": "EBIT + NONOP84 + NONOP87"},
  {"reference_code": "TAX91", "display_name": "Орлогын албан татварын зардал (91)", "indentation_level": 0, "data_source": "Account Data", "balance_type": "Period Movement (Debits - Credits)", "reverse_sign": 1,
   "calculation_formula": "[\"account_category\", \"=\", \"Tax Expense\"]"},
  {"reference_code": "NET", "display_name": "ТАЙЛАНТ ҮЕИЙН ЦЭВЭР АШИГ (АЛДАГДАЛ)", "indentation_level": 0, "data_source": "Calculated Amount", "bold_text": 1, "include_in_charts": 1,
   "calculation_formula": "PBT + TAX91"},
  {"data_source": "Blank Line"},
  {"reference_code": "CHK_INC", "display_name": "Шалгалт: нийт орлого (root_type)", "indentation_level": 0, "data_source": "Account Data", "balance_type": "Period Movement (Debits - Credits)", "reverse_sign": 1, "hidden_calculation": 1,
   "calculation_formula": "[\"root_type\", \"=\", \"Income\"]"},
  {"reference_code": "CHK_EXP", "display_name": "Шалгалт: нийт зардал (root_type)", "indentation_level": 0, "data_source": "Account Data", "balance_type": "Period Movement (Debits - Credits)", "reverse_sign": 0, "hidden_calculation": 1,
   "calculation_formula": "[\"root_type\", \"=\", \"Expense\"]"},
  {"reference_code": "CHK_DIFF", "display_name": "Шалгалт: ангилаагүй данс (0 байх ёстой)", "indentation_level": 0, "data_source": "Calculated Amount", "italic_text": 1,
