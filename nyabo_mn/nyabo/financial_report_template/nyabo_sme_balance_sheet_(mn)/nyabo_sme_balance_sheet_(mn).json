  {"reference_code": "NCL", "display_name": "Урт хугацаат өр төлбөр", "indentation_level": 1, "data_source": "Account Data", "balance_type": "Closing Balance", "reverse_sign": 1, "hide_when_empty": 1,
   "calculation_formula": "[\"account_category\", \"in\", [\"Long-term Borrowings\", \"Long-term Provisions\", \"Other Non-current Liabilities\"]]"},
