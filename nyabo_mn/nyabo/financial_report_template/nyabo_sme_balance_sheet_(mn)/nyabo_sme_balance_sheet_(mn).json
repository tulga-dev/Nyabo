   "calculation_formula": "CL_TOTAL + NCL"},
  {"data_source": "Blank Line"},
  {"reference_code": "H_EQ", "display_name": "ЭЗЭМШИГЧИЙН ӨМЧ (41)", "indentation_level": 0, "data_source": "Blank Line", "bold_text": 1},
  {"reference_code": "EQ41", "display_name": "Хувь нийлүүлсэн хөрөнгө", "indentation_level": 1, "data_source": "Account Data", "balance_type": "Closing Balance", "reverse_sign": 1,
   "calculation_formula": "[\"account_category\", \"=\", \"Share Capital\"]"},
  {"reference_code": "EQ41R", "display_name": "Хуримтлагдсан ашиг (алдагдал), бусад өмч", "indentation_level": 1, "data_source": "Account Data", "balance_type": "Closing Balance", "reverse_sign": 1,
   "calculation_formula": "[\"account_category\", \"=\", \"Reserves and Surplus\"]"},
