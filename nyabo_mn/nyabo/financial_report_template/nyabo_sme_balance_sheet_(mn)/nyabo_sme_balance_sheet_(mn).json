   "calculation_formula": "[\"root_type\", \"in\", [\"Income\", \"Expense\"]]"},
  {"reference_code": "TOTAL_EQ", "display_name": "ЭЗЭМШИГЧИЙН ӨМЧИЙН ДҮН", "indentation_level": 0, "data_source": "Calculated Amount", "bold_text": 1, "include_in_charts": 1,
   "calculation_formula": "EQ41 + EQ41R + EQ_PL"},
  {"data_source": "Blank Line"},
  {"reference_code": "TOTAL_LIAB_EQ", "display_name": "ӨР ТӨЛБӨР БА ЭЗЭМШИГЧИЙН ӨМЧИЙН ДҮН", "indentation_level": 0, "data_source": "Calculated Amount", "bold_text": 1,
   "calculation_formula": "TOTAL_LIAB + TOTAL_EQ"},
  {"reference_code": "CHECK", "display_name": "Тэнцлийн шалгалт (0 байх ёстой)", "indentation_level": 0, "data_source": "Calculated Amount", "italic_text": 1,
   "calculation_formula": "TOTAL_ASSETS - TOTAL_LIAB_EQ"}
 ]
