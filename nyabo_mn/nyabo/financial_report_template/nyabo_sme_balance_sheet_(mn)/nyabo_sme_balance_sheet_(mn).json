  {"data_source": "Blank Line"},
  {"reference_code": "TOTAL_ASSETS", "display_name": "НИЙТ ХӨРӨНГИЙН ДҮН", "indentation_level": 0, "data_source": "Calculated Amount", "bold_text": 1, "include_in_charts": 1,
