  {"reference_code": "H_LIAB", "display_name": "ӨР ТӨЛБӨР", "indentation_level": 0, "data_source": "Blank Line", "bold_text": 1},
  {"reference_code": "CL31", "display_name": "Дансны өглөг (31)", "indentation_level": 1, "data_source": "Account Data", "balance_type": "Closing Balance", "reverse_sign": 1,
   "calculation_formula": "[\"account_category\", \"=\", \"Trade Payables\"]"},
  {"reference_code": "CL31T", "display_name": "Татварын өглөг", "indentation_level": 1, "data_source": "Account Data", "balance_type": "Closing Balance", "reverse_sign": 1,
   "calculation_formula": "[\"account_category\", \"=\", \"Current Tax Liabilities\"]"},
  {"reference_code": "CL31O", "display_name": "Цалин, НДШ болон бусад өглөг", "indentation_level": 1, "data_source": "Account Data", "balance_type": "Closing Balance", "reverse_sign": 1,
