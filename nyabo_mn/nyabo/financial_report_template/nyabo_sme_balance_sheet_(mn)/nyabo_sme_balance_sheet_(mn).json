  {"reference_code": "H_ASSETS", "display_name": "ХӨРӨНГӨ", "indentation_level": 0, "data_source": "Blank Line", "bold_text": 1},
  {"reference_code": "H_CA", "display_name": "Эргэлтийн хөрөнгө", "indentation_level": 0, "data_source": "Blank Line", "bold_text": 1},
  {"reference_code": "CA10", "display_name": "Мөнгө, түүнтэй адилтгах хөрөнгө (10, 11)", "indentation_level": 1, "data_source": "Account Data", "balance_type": "Closing Balance", "reverse_sign": 0,
   "calculation_formula": "{\"or\": [[\"account_category\", \"=\", \"Cash and Cash Equivalents\"], [\"account_number\", \"like\", \"10%\"], [\"account_number\", \"like\", \"11%\"]]}"},
  {"reference_code": "CA12", "display_name": "Дансны авлага (12)", "indentation_level": 1, "data_source": "Account Data", "balance_type": "Closing Balance", "reverse_sign": 0,
   "calculation_formula": "[\"account_category\", \"=\", \"Trade Receivables\"]"},
  {"reference_code": "CA12B", "display_name": "Бусад авлага, татварын авлага", "indentation_level": 1, "data_source": "Account Data", "balance_type": "Closing Balance", "reverse_sign": 0,
   "calculation_formula": "[\"account_category\", \"in\", [\"Other Receivables\", \"Other Current Assets\"]]"},
  {"reference_code": "CA13", "display_name": "Богино хугацаат хөрөнгө оруулалт (13)", "indentation_level": 1, "data_source": "Account Data", "balance_type": "Closing Balance", "reverse_sign": 0, "hide_when_empty": 1,
   "calculation_formula": "[\"account_category\", \"=\", \"Short-term Investments\"]"},
  {"reference_code": "CA14", "display_name": "Бараа материал (14, 15)", "indentation_level": 1, "data_source": "Account Data", "balance_type": "Closing Balance", "reverse_sign": 0,
   "calculation_formula": "[\"account_category\", \"=\", \"Stock Assets\"]"},
  {"reference_code": "CA_TOTAL", "display_name": "Эргэлтийн хөрөнгийн дүн", "indentation_level": 1, "data_source": "Calculated Amount", "bold_text": 1,
   "calculation_formula": "CA10 + CA12 + CA12B + CA13 + CA14"},
  {"data_source": "Blank Line"},
  {"reference_code": "H_NCA", "display_name": "Эргэлтийн бус хөрөнгө", "indentation_level": 0, "data_source": "Blank Line", "bold_text": 1},
  {"reference_code": "NCA20", "display_name": "Үндсэн хөрөнгө (цэвэр) (20)", "indentation_level": 1, "data_source": "Account Data", "balance_type": "Closing Balance", "reverse_sign": 0,
   "calculation_formula": "[\"account_category\", \"=\", \"Tangible Assets\"]"},
  {"reference_code": "NCA21", "display_name": "Биет бус хөрөнгө (21)", "indentation_level": 1, "data_source": "Account Data", "balance_type": "Closing Balance", "reverse_sign": 0, "hide_when_empty": 1,
   "calculation_formula": "[\"account_category\", \"=\", \"Intangible Assets\"]"},
  {"reference_code": "NCA22", "display_name": "Урт хугацаат хөрөнгө оруулалт (22)", "indentation_level": 1, "data_source": "Account Data", "balance_type": "Closing Balance", "reverse_sign": 0, "hide_when_empty": 1,
   "calculation_formula": "[\"account_category\", \"in\", [\"Long-term Investments\", \"Other Non-current Assets\"]]"},
